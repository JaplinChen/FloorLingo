{
    "name": "japlinchen/floorlingo",
    "description": "Official PHP SDK for FloorLingo WhatsApp API Gateway",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "floorlingo",
        "gateway"
    ],
    "homepage": "https://github.com/JaplinChen/FloorLingo",
    "authors": [
        {
            "name": "FloorLingo Contributors",
            "homepage": "https://github.com/JaplinChen/FloorLingo"
        }
    ],
    "support": {
        "issues": "https://github.com/JaplinChen/FloorLingo/issues",
        "source": "https://github.com/JaplinChen/FloorLingo"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "FloorLingo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FloorLingo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}